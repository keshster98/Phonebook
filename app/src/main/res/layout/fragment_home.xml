<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <!-- Top navbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mtTopNavbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:titleCentered="true"
        app:title="@string/app_name">
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- To house the nested fragments (Contacts, Highlights and Settings) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_nil"
        android:layout_below="@id/mtTopNavbar"
        android:layout_above="@id/nvBottomNavbar" />

    <!-- Bottom navbar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nvBottomNavbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        android:background="?attr/colorSurface"/>

</RelativeLayout>
