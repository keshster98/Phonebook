<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.keshen.myapplication.ui.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_contactDetailsFragment"
            app:enterAnim="@anim/from_down"
            app:exitAnim="@anim/to_up"
            app:popEnterAnim="@anim/from_up"
            app:popExitAnim="@anim/to_down"
            app:destination="@id/contactDetailsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_addContactFragment"
            app:enterAnim="@anim/from_right"
            app:exitAnim="@anim/to_left"
            app:popEnterAnim="@anim/from_left"
            app:popExitAnim="@anim/to_right"
            app:destination="@id/addContactFragment" />
        <action
            android:id="@+id/action_homeFragment_to_sortContactsFragment"
            app:enterAnim="@anim/from_down"
            app:exitAnim="@anim/to_up"
            app:popEnterAnim="@anim/from_up"
            app:popExitAnim="@anim/to_down"
            app:destination="@id/sortContactsFragment" />
    </fragment>
    <fragment
        android:id="@+id/contactDetailsFragment"
        android:name="com.keshen.myapplication.ui.details.ContactDetailsFragment"
        android:label="ContactDetailsFragment">
        <argument
            android:name="contact"
            app:argType="com.keshen.myapplication.data.model.Contact"
            app:nullable="false" />
        <action
            android:id="@+id/action_contactDetailsFragment_to_editContactFragment"
            app:enterAnim="@anim/from_down"
            app:exitAnim="@anim/to_up"
            app:popEnterAnim="@anim/from_up"
            app:popExitAnim="@anim/to_down"
            app:destination="@id/editContactFragment" />
        <action
            android:id="@+id/action_contactDetailsFragment_to_confirmationDeleteFragment"
            app:enterAnim="@anim/from_down"
            app:exitAnim="@anim/to_up"
            app:popEnterAnim="@anim/from_up"
            app:popExitAnim="@anim/to_down"
            app:destination="@id/confirmationDeleteFragment" />
    </fragment>
    <fragment
        android:id="@+id/editContactFragment"
        android:name="com.keshen.myapplication.ui.manage.EditContactFragment"
        android:label="EditContactFragment" >
        <argument
            android:name="contactId"
            app:argType="integer"
            app:nullable="false" />
        <action
            android:id="@+id/action_editContactFragment_to_contactDetailsFragment"
            app:destination="@id/contactDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/addContactFragment"
        android:name="com.keshen.myapplication.ui.manage.AddContactFragment"
        android:label="AddContactFragment" >
        <action
            android:id="@+id/action_addContactFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <dialog
        android:id="@+id/confirmationDeleteFragment"
        android:name="com.keshen.myapplication.ui.confirmationDelete.ConfirmationDeleteFragment"
        android:label="ConfirmationDeleteFragment"
        tools:layout="@layout/fragment_confirmation_delete">
        <argument
            android:name="contactId"
            app:argType="integer" />
        <action
            android:id="@+id/action_confirmationDeleteFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </dialog>
    <dialog
        android:id="@+id/sortContactsFragment"
        android:name="com.keshen.myapplication.ui.sort.SortContactsFragment"
        android:label="SortContactsFragment"
        tools:layout="@layout/fragment_sort_contacts">
        <argument
            android:name="sort1"
            app:argType="integer" />
        <argument
            android:name="sort2"
            app:argType="integer" />
    </dialog>
</navigation>